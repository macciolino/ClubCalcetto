{
  "name": "club-calcetto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "dev:emulators": "node scripts/dev-emulators.mjs",
    "seed:emulators": "node scripts/seed-emulators.mjs",
    "backup:firestore": "node scripts/backup-firestore.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-clubcalcetto \"node scripts/test-rules.mjs\"",
    "test": "npm run test:unit",
    "test:unit": "node scripts/vitest.mjs run tests/unit",
    "test:integration": "firebase emulators:exec --config firebase.test.json --only auth,firestore --project demo-clubcalcetto \"node scripts/vitest.mjs run tests/integration\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:integration && npm run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^9.14.0",
    "firebase-admin": "^13.10.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^0.475.0",
    "next": "^16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^20.17.16",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.35.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "4.1.12"
  }
}

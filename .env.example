# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Notifications
ADMIN_NOTIFICATION_EMAIL=macciolino84@gmail.com
RESEND_API_KEY=

# Google AI Studio (Gemini API Key)
GEMINI_API_KEY=your-gemini-api-key

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# --- Push notifications (Firebase Cloud Messaging, free) ---
# Public "Web Push certificate" key: Firebase console > Project settings > Cloud Messaging > Web configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# SECRET service account (Firebase console > Project settings > Service accounts > Generate new private key).
# Set ONLY on Vercel (Production), never commit them.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

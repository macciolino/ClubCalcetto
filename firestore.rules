rules_version = '2';

// ============================================================================
// ClubCalcetto - Firestore Security Rules
// ----------------------------------------------------------------------------
// Roles
//  - Super admin : the verified account macciolino84@gmail.com (profile doc 'p-1')
//  - Admin       : a profile whose role == 'admin' (promoted ONLY by the super admin)
//  - Player      : any other signed-in user
// Nobody who is not signed in can read or write anything.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'macciolino84@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function isAdmin() {
      return isSuperAdmin()
        || (signedIn() && exists(myProfilePath()) && get(myProfilePath()).data.role == 'admin');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // Admins (not super admin) may not change roles, except normalising the legacy value 'user' -> 'player'
    function roleUntouchedOrLegacyFix() {
      return !('role' in changedKeys())
        || (resource.data.role == 'user' && request.resource.data.role == 'player');
    }

    // Admins promote / demote other admins: never the super admin profile, and guests (no account) never become admin.
    function adminRoleChange(profileId) {
      return profileId != 'p-1'
        && request.resource.data.role in ['admin', 'player']
        && (request.resource.data.role != 'admin' || resource.data.get('is_guest', false) == false);
    }

    // Profile photo: only a real photo chosen by the player (small JPEG made by the app) or the Google photo.
    // Preset images (SVG emoji avatars) and huge images are refused.
    function isValidAvatar(v) {
      return v == null
        || (v is string && v.size() <= 150000
            && (v.matches('^https://[^ ]+$') || v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }

    // ---------- profiles ----------
    // Self-registration (C3): only the fields written by the app (AuthContext buildNewProfile), not a guest,
    // and starting parameters no higher than the club defaults (categories default to 6 or 7), so nobody can
    // join with all 10s. Server-only flags (review, self-assessment, return request…) cannot be set here.
    // If an admin ever raises a category default above 7, raise this cap too.
    function isValidNewOwnProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'user_id', 'email', 'full_name', 'first_name', 'last_name', 'avatar_url',
              'role', 'position', 'is_guest', 'stats', 'overall_rating', 'matches_won', 'matches_drawn',
              'matches_lost', 'created_at', 'updated_at'])
        && d.get('is_guest', false) == false
        && d.get('user_id', request.auth.uid) == request.auth.uid
        && isValidAvatar(d.get('avatar_url', null))
        && (!('stats' in d) || (d.stats is map && d.stats.values().hasOnly([1, 2, 3, 4, 5, 6, 7])))
        && (!('overall_rating' in d) || (d.overall_rating is number && d.overall_rating >= 1 && d.overall_rating <= 7));
    }

    // C2: the email is personal data and lives in private_profiles. A client can never ADD or CHANGE it in the
    // public profile (profiles not moved yet keep theirs until the super admin moves them; removing it is allowed).
    function profileEmailUntouched() {
      return request.resource.data.get('email', null) == null
        || (resource != null && request.resource.data.get('email', null) == resource.data.get('email', null));
    }

    match /profiles/{profileId} {
      allow read: if signedIn();

      // A user creates ONLY their own profile (doc id = their uid), always as a plain player with no match history.
      // Admins can create guest/manual players, but only the super admin can create another admin.
      allow create: if profileEmailUntouched() && (isSuperAdmin()
        || (isAdmin() && request.resource.data.role != 'admin')
        || (signedIn()
            && profileId == request.auth.uid
            && request.resource.data.role == 'player'
            && request.resource.data.get('matches_won', 0) == 0
            && request.resource.data.get('matches_drawn', 0) == 0
            && request.resource.data.get('matches_lost', 0) == 0
            && isValidNewOwnProfile()));

      // Super admin: everything. Admin: stats, records, data (not roles). Player: only cosmetic fields of their own profile.
      allow update: if profileEmailUntouched() && (isSuperAdmin()
        || (isAdmin() && (roleUntouchedOrLegacyFix() || adminRoleChange(profileId)))
        || (signedIn()
            && profileId == request.auth.uid
            && onlyChanges(['full_name', 'avatar_url', 'position', 'locale', 'theme', 'updated_at'])
            && (!('avatar_url' in changedKeys()) || isValidAvatar(request.resource.data.avatar_url))
            // Preferenze personali: lingua dell'app e tema
            && (!('locale' in changedKeys()) || request.resource.data.locale in ['it', 'en'])
            && (!('theme' in changedKeys()) || request.resource.data.theme in ['system', 'light', 'dark'])));

      // The super admin profile can never be deleted. Admins delete only GUESTS (players without an account);
      // registered accounts are deleted only by the super admin, from the app via the server (login + data).
      allow delete: if profileId != 'p-1'
        && (isSuperAdmin() || (isAdmin() && resource.data.get('is_guest', false) == true));
    }

    // ---------- C2: private data of a profile (email) ----------
    // Read: the player (own) and admins. Write: the player, only their own sign-in email; the server moves the old ones.
    match /private_profiles/{profileId} {
      allow read: if isAdmin() || isOwnProfile(profileId);
      allow create, update: if isOwnProfile(profileId)
        && request.resource.data.keys().hasOnly(['email', 'updated_at'])
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if isSuperAdmin();
    }

    // ---------- in-app bell (profiles/{id}/notifications) ----------
    // Written only by the server (Admin SDK). Each person reads, marks as read and deletes ONLY their own.
    function isOwnProfile(profileId) {
      return signedIn() && (profileId == request.auth.uid || (profileId == 'p-1' && isSuperAdmin()));
    }
    match /profiles/{profileId}/notifications/{notificationId} {
      allow read, delete: if isOwnProfile(profileId);
      allow update: if isOwnProfile(profileId) && onlyChanges(['read']) && request.resource.data.read == true;
      allow create: if false;
    }

    // ---------- presences ----------
    // Titolari / waitlist are COMPUTED by the app from the sign-up order (joined_at = server time),
    // so a player only ever creates or deletes their OWN presence, never edits anyone else's.

    function calendarPath() {
      return /databases/$(database)/documents/settings/calendar;
    }

    // 'YYYY-MM-DD' -> timestamp (midnight UTC)
    function dateToTimestamp(d) {
      let parts = d.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // Start of next week (Monday 00:00), using Italian time approximated as UTC+1
    function nextMondayStart() {
      let now = request.time + duration.value(1, 'h');
      return now.date() + duration.value(8 - now.dayOfWeek(), 'd');
    }

    // Current week is always open; later days only up to settings/calendar.open_until (set by an admin)
    function isDateOpenForPlayers(d) {
      return dateToTimestamp(d) < nextMondayStart()
        || (exists(calendarPath()) && d <= get(calendarPath()).data.get('open_until', ''));
    }

    function isValidNewPresence(presenceId) {
      let data = request.resource.data;
      return data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.player_id is string
        && presenceId == data.date + '_' + data.player_id   // one presence per player per day
        && data.joined_at == request.time                   // queue position = server time, cannot be faked
        && data.keys().hasOnly(['id', 'date', 'player_id', 'status', 'order_index', 'created_at', 'joined_at']);
    }

    match /presences/{presenceId} {
      allow read: if signedIn();

      // Players sign up only themselves, only on open days. Admins can add anyone on any day.
      allow create: if signedIn()
        && isValidNewPresence(presenceId)
        && (isAdmin()
            || (request.resource.data.player_id == request.auth.uid
                && isDateOpenForPlayers(request.resource.data.date)));

      // Withdraw: own presence, or anyone's for admins (the waitlist moves up automatically)
      allow delete: if isAdmin()
        || (signedIn() && resource.data.player_id == request.auth.uid);

      // Only admins edit a presence (e.g. admin_override to force starter / waitlist)
      allow update: if isAdmin();
    }

    // ---------- club data: everyone signed in reads, only admins write ----------
    match /stat_categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /generated_teams/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- MVP votes (one per person per match day, doc id = date_uid) ----------
    // Everyone signed in can vote; the app opens the vote 45 minutes after the end of the match, for 24 hours.
    // Rules allow it from the match day up to 3 days later; earlier only for admins or during an
    // admin "test with everyone" on that day;
    // the vote can be changed, never cast on behalf of someone else.
    function isValidMvpVote(voteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'voter_id', 'player_id', 'updated_at'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.voter_id == request.auth.uid
        && voteId == data.date + '_' + request.auth.uid
        && data.player_id is string
        && data.player_id.size() > 0
        && data.updated_at == request.time
        && (isAdmin()
            || isMvpTestForAll(data.date)
            || (request.time >= dateToTimestamp(data.date)
                && request.time < dateToTimestamp(data.date) + duration.value(3, 'd')));
    }
    // An admin opened a test vote for everyone on that match day ("Prova con tutti")
    function isMvpTestForAll(d) {
      let teams = /databases/$(database)/documents/generated_teams/$(d);
      return exists(teams) && get(teams).data.get('mvp_vote_test', false) == 'all';
    }
    // ---------- push notification devices (doc id = FCM token) ----------
    // Each person registers only their own devices (linked to their own profile); notifications are sent
    // by the server with the Admin SDK, which ignores these rules. Nobody reads other people's tokens.
    match /push_tokens/{token} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'profile_id', 'platform', 'updated_at'])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.profile_id == request.auth.uid
            || (isSuperAdmin() && request.resource.data.profile_id == 'p-1'))
        && request.resource.data.platform in ['ios', 'android', 'desktop']
        && request.resource.data.updated_at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /mvp_votes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isValidMvpVote(voteId);
      allow delete: if isAdmin() || (signedIn() && resource.data.voter_id == request.auth.uid);
    }
    match /match_payments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /sport_fields/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Admins' notification centre: written only by the server (Admin SDK); admins read it.
    // Invite links (`invites`) are server only: no rule, so denied.
    match /admin_requests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything else is denied by default.
  }
}

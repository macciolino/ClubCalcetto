rules_version = '2';

// ============================================================================
// ClubCalcetto - Firestore Security Rules
// ----------------------------------------------------------------------------
// Roles
//  - Super admin : the verified account macciolino84@gmail.com (profile doc 'p-1')
//  - Admin       : a profile whose role == 'admin' (promoted ONLY by the super admin)
//  - Player      : any other signed-in user
// Nobody who is not signed in can read or write anything.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email == 'macciolino84@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function myProfilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function isAdmin() {
      return isSuperAdmin()
        || (signedIn() && exists(myProfilePath()) && get(myProfilePath()).data.role == 'admin');
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // Admins (not super admin) may not change roles, except normalising the legacy value 'user' -> 'player'
    function roleUntouchedOrLegacyFix() {
      return !('role' in changedKeys())
        || (resource.data.role == 'user' && request.resource.data.role == 'player');
    }

    // Profile photo: only a real photo chosen by the player (small JPEG made by the app) or the Google photo.
    // Preset images (SVG emoji avatars) and huge images are refused.
    function isValidAvatar(v) {
      return v == null
        || (v is string && v.size() <= 150000
            && (v.matches('^https://[^ ]+$') || v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }

    // ---------- profiles ----------
    match /profiles/{profileId} {
      allow read: if signedIn();

      // A user creates ONLY their own profile (doc id = their uid), always as a plain player with no match history.
      // Admins can create guest/manual players, but only the super admin can create another admin.
      allow create: if isSuperAdmin()
        || (isAdmin() && request.resource.data.role != 'admin')
        || (signedIn()
            && profileId == request.auth.uid
            && request.resource.data.role == 'player'
            && request.resource.data.get('matches_won', 0) == 0
            && request.resource.data.get('matches_drawn', 0) == 0
            && request.resource.data.get('matches_lost', 0) == 0);

      // Super admin: everything. Admin: stats, records, data (not roles). Player: only cosmetic fields of their own profile.
      allow update: if isSuperAdmin()
        || (isAdmin() && roleUntouchedOrLegacyFix())
        || (signedIn()
            && profileId == request.auth.uid
            && onlyChanges(['full_name', 'avatar_url', 'position', 'updated_at'])
            && (!('avatar_url' in changedKeys()) || isValidAvatar(request.resource.data.avatar_url)));

      // The super admin profile can never be deleted; only the super admin can delete an admin.
      allow delete: if profileId != 'p-1'
        && (isSuperAdmin() || (isAdmin() && resource.data.role != 'admin'));
    }

    // ---------- presences ----------
    // Titolari / waitlist are COMPUTED by the app from the sign-up order (joined_at = server time),
    // so a player only ever creates or deletes their OWN presence, never edits anyone else's.

    function calendarPath() {
      return /databases/$(database)/documents/settings/calendar;
    }

    // 'YYYY-MM-DD' -> timestamp (midnight UTC)
    function dateToTimestamp(d) {
      let parts = d.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // Start of next week (Monday 00:00), using Italian time approximated as UTC+1
    function nextMondayStart() {
      let now = request.time + duration.value(1, 'h');
      return now.date() + duration.value(8 - now.dayOfWeek(), 'd');
    }

    // Current week is always open; later days only up to settings/calendar.open_until (set by an admin)
    function isDateOpenForPlayers(d) {
      return dateToTimestamp(d) < nextMondayStart()
        || (exists(calendarPath()) && d <= get(calendarPath()).data.get('open_until', ''));
    }

    function isValidNewPresence(presenceId) {
      let data = request.resource.data;
      return data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.player_id is string
        && presenceId == data.date + '_' + data.player_id   // one presence per player per day
        && data.joined_at == request.time                   // queue position = server time, cannot be faked
        && data.keys().hasOnly(['id', 'date', 'player_id', 'status', 'order_index', 'created_at', 'joined_at']);
    }

    match /presences/{presenceId} {
      allow read: if signedIn();

      // Players sign up only themselves, only on open days. Admins can add anyone on any day.
      allow create: if signedIn()
        && isValidNewPresence(presenceId)
        && (isAdmin()
            || (request.resource.data.player_id == request.auth.uid
                && isDateOpenForPlayers(request.resource.data.date)));

      // Withdraw: own presence, or anyone's for admins (the waitlist moves up automatically)
      allow delete: if isAdmin()
        || (signedIn() && resource.data.player_id == request.auth.uid);

      // Only admins edit a presence (e.g. admin_override to force starter / waitlist)
      allow update: if isAdmin();
    }

    // ---------- club data: everyone signed in reads, only admins write ----------
    match /stat_categories/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /generated_teams/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- MVP votes (one per person per match day, doc id = date_uid) ----------
    // Everyone signed in can vote; the app opens the vote 45 minutes after the end of the match, for 24 hours.
    // Rules allow it from the match day up to 3 days later (admins also earlier, to test the vote);
    // the vote can be changed, never cast on behalf of someone else.
    function isValidMvpVote(voteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'voter_id', 'player_id', 'updated_at'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.voter_id == request.auth.uid
        && voteId == data.date + '_' + request.auth.uid
        && data.player_id is string
        && data.player_id.size() > 0
        && data.updated_at == request.time
        && (isAdmin()
            || (request.time >= dateToTimestamp(data.date)
                && request.time < dateToTimestamp(data.date) + duration.value(3, 'd')));
    }
    // ---------- push notification devices (doc id = FCM token) ----------
    // Each person registers only their own devices (linked to their own profile); notifications are sent
    // by the server with the Admin SDK, which ignores these rules. Nobody reads other people's tokens.
    match /push_tokens/{token} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'profile_id', 'platform', 'updated_at'])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.profile_id == request.auth.uid
            || (isSuperAdmin() && request.resource.data.profile_id == 'p-1'))
        && request.resource.data.platform in ['ios', 'android', 'desktop']
        && request.resource.data.updated_at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /mvp_votes/{voteId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && isValidMvpVote(voteId);
      allow delete: if isAdmin() || (signedIn() && resource.data.voter_id == request.auth.uid);
    }
    match /match_payments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /sport_fields/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Anything else is denied by default.
  }
}

rules_version = '2';

// ============================================================================
// ClubCalcetto - Firestore Security Rules
// ----------------------------------------------------------------------------
// Roles
//  - Platform    : profiles.platformRole (written ONLY by the server). SUPER_ADMIN is the only global power in
//                  these rules; GLOBAL_ADMIN (platform helper) works through the server console, not here.
//  - League roles: PRESIDENT / COLLABORATOR / PLAYER on leagues/{id}/players (see "Multi-league" below):
//                  they count ONLY inside their league. There is no global "admin" any more (the old
//                  profiles.role == 'admin' grants nothing).
//  - Player      : any other signed-in user
// Nobody who is not signed in can read or write anything.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    // The founder's legacy profile 'p-1' (created before Firebase Auth) belongs to the account whose uid is in its
    // user_id (repaired by the server); the email only helps to locate it, it grants nothing by itself.
    function legacyProfilePath() {
      return /databases/$(database)/documents/profiles/p-1;
    }
    function ownsLegacyProfile() {
      return signedIn() && request.auth.token.email_verified == true && exists(legacyProfilePath())
        && (get(legacyProfilePath()).data.get('user_id', '') == request.auth.uid
            || request.auth.token.email == 'macciolino84@gmail.com');
    }
    // The caller's global account: profiles/{uid}, or the legacy 'p-1'
    function myAccountPath() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        ? /databases/$(database)/documents/profiles/$(request.auth.uid)
        : legacyProfilePath();
    }
    function myPlatformRole() {
      return exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) || ownsLegacyProfile()
        ? get(myAccountPath()).data.get('platformRole', 'USER')
        : 'USER';
    }
    // Platform super admin = platformRole SUPER_ADMIN on the caller's own account, with a verified email
    function isSuperAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && myPlatformRole() == 'SUPER_ADMIN';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    // Profile photo: only a real photo chosen by the player (small JPEG made by the app) or the Google photo.
    // Preset images (SVG emoji avatars) and huge images are refused.
    function isValidAvatar(v) {
      return v == null
        || (v is string && v.size() <= 150000
            && (v.matches('^https://[^ ]+$') || v.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }

    // ---------- profiles ----------
    // Self-registration (C3): only the fields written by the app (AuthContext buildNewProfile), not a guest,
    // and starting parameters no higher than the club defaults (categories default to 6 or 7), so nobody can
    // join with all 10s. Server-only flags (review, self-assessment, return request…) cannot be set here.
    // If an admin ever raises a category default above 7, raise this cap too.
    function isValidNewOwnProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'user_id', 'email', 'full_name', 'first_name', 'last_name', 'avatar_url',
              'role', 'position', 'is_guest', 'stats', 'overall_rating', 'matches_won', 'matches_drawn',
              'matches_lost', 'created_at', 'updated_at'])
        && d.get('is_guest', false) == false
        && d.get('user_id', request.auth.uid) == request.auth.uid
        && isValidAvatar(d.get('avatar_url', null))
        && (!('stats' in d) || (d.stats is map && d.stats.values().hasOnly([1, 2, 3, 4, 5, 6, 7])))
        && (!('overall_rating' in d) || (d.overall_rating is number && d.overall_rating >= 1 && d.overall_rating <= 7));
    }

    // C2: the email is personal data and lives in private_profiles. A client can never ADD or CHANGE it in the
    // public profile (profiles not moved yet keep theirs until the super admin moves them; removing it is allowed).
    function profileEmailUntouched() {
      return request.resource.data.get('email', null) == null
        || (resource != null && request.resource.data.get('email', null) == resource.data.get('email', null));
    }

    // Step 4: the platform role (governance) is written only by the server — never from the app, not even by admins.
    function platformRoleUntouched() {
      return resource == null
        ? !('platformRole' in request.resource.data)
        : request.resource.data.get('platformRole', null) == resource.data.get('platformRole', null);
    }

    match /profiles/{profileId} {
      allow read: if signedIn();

      // A user creates ONLY their own profile (doc id = their uid), always as a plain player with no match history.
      // Guests are league cards (leagues/{id}/players), not global profiles: nobody else creates profiles.
      allow create: if profileEmailUntouched() && platformRoleUntouched() && (isSuperAdmin()
        || (signedIn()
            && profileId == request.auth.uid
            && request.resource.data.role == 'player'
            && request.resource.data.get('matches_won', 0) == 0
            && request.resource.data.get('matches_drawn', 0) == 0
            && request.resource.data.get('matches_lost', 0) == 0
            && isValidNewOwnProfile()));

      // Super admin: everything (never the platform role). Everyone else: only cosmetic fields of their own profile.
      // League managers edit parameters and records on the league CARD, never on someone's global account.
      allow update: if profileEmailUntouched() && platformRoleUntouched() && (isSuperAdmin()
        || (signedIn()
            && profileId == request.auth.uid
            && onlyChanges(['full_name', 'avatar_url', 'position', 'locale', 'theme', 'updated_at'])
            && (!('avatar_url' in changedKeys()) || isValidAvatar(request.resource.data.avatar_url))
            // Preferenze personali: lingua dell'app e tema
            && (!('locale' in changedKeys()) || request.resource.data.locale in ['it', 'en'])
            && (!('theme' in changedKeys()) || request.resource.data.theme in ['system', 'light', 'dark'])));

      // The super admin profile can never be deleted. Accounts are deleted by the server (owner or super admin).
      allow delete: if profileId != 'p-1' && isSuperAdmin();
    }

    // ---------- C2: private data of a profile (email) ----------
    // Read: the player (own) and the super admin. League managers get ONLY their league members' emails from the
    // server (/api/league-emails), never this collection: no reading people of other leagues.
    // Write: the player, only their own sign-in email; the server moves the old ones.
    match /private_profiles/{profileId} {
      allow read: if isSuperAdmin() || isOwnProfile(profileId);
      allow create, update: if isOwnProfile(profileId)
        && request.resource.data.keys().hasOnly(['email', 'updated_at'])
        && request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if isSuperAdmin();
    }

    // ---------- in-app bell (profiles/{id}/notifications) ----------
    // Written only by the server (Admin SDK). Each person reads, marks as read and deletes ONLY their own.
    function isOwnProfile(profileId) {
      return signedIn() && (profileId == request.auth.uid || (profileId == 'p-1' && ownsLegacyProfile()));
    }
    match /profiles/{profileId}/notifications/{notificationId} {
      allow read, delete: if isOwnProfile(profileId);
      allow update: if isOwnProfile(profileId) && onlyChanges(['read']) && request.resource.data.read == true;
      allow create: if false;
    }

    // 'YYYY-MM-DD' -> timestamp (midnight UTC)
    function dateToTimestamp(d) {
      let parts = d.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]));
    }

    // C14: Italian time. Summer time (UTC+2) runs from the last Sunday of March to the last Sunday of October,
    // both at 01:00 UTC; otherwise UTC+1. March and October have 31 days; dayOfWeek: Monday = 1 … Sunday = 7.
    function lastSundayAt1Utc(year, month) {
      let last = timestamp.date(year, month, 31);
      return last - duration.value(last.dayOfWeek() % 7, 'd') + duration.value(1, 'h');
    }
    function isItalianSummerTime(t) {
      return t >= lastSundayAt1Utc(t.year(), 3) && t < lastSundayAt1Utc(t.year(), 10);
    }
    function toItalianTime(t) {
      return isItalianSummerTime(t) ? t + duration.value(2, 'h') : t + duration.value(1, 'h');
    }

    // ---------- push notification devices (doc id = FCM token) ----------
    // Each person registers only their own devices (linked to their own profile); notifications are sent
    // by the server with the Admin SDK, which ignores these rules. Nobody reads other people's tokens.
    match /push_tokens/{token} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'profile_id', 'platform', 'updated_at'])
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.profile_id == request.auth.uid
            || (request.resource.data.profile_id == 'p-1' && ownsLegacyProfile()))
        && request.resource.data.platform in ['ios', 'android', 'desktop']
        && request.resource.data.updated_at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }


    // ============================================================================
    // Multi-league (1B). Every club collection lives in leagues/{leagueId}/…
    //  - memberships/{uid}.leagues.{leagueId}.player_id : the user's card in that league (written by the server)
    //  - leagues/{leagueId}/players/{playerId}.leagueRole : PRESIDENT | COLLABORATOR | PLAYER (the real role)
    // Members read their league; presidents and collaborators ("managers") write matches, teams, cash, settings;
    // presidents change roles. The platform super admin reads every league (governance), writes only where member.
    // Suspended league (step 4): everyone still reads, nobody writes. Invite codes (league_invites): server only.
    // ============================================================================
    function membershipPath() {
      return /databases/$(database)/documents/memberships/$(request.auth.uid);
    }
    // Verified email required (Google accounts always are): an unverified account using someone's address gets nothing
    function isLeagueMember(leagueId) {
      return signedIn() && request.auth.token.email_verified == true && exists(membershipPath()) && leagueId in get(membershipPath()).data.get('leagues', {});
    }
    function myPlayerId(leagueId) {
      return get(membershipPath()).data.leagues[leagueId].player_id;
    }
    function myCard(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)/players/$(myPlayerId(leagueId))).data;
    }
    // Step 4: a league suspended by the platform super admin is read-only for everyone (the server too stops writing)
    function isLeagueActive(leagueId) {
      return get(/databases/$(database)/documents/leagues/$(leagueId)).data.get('status', 'active') == 'active';
    }
    function canWriteLeague(leagueId) {
      return isLeagueMember(leagueId) && isLeagueActive(leagueId);
    }
    function hasLeagueRole(leagueId, roles) {
      return canWriteLeague(leagueId)
        && myCard(leagueId).get('leagueRole', 'PLAYER') in roles
        && myCard(leagueId).get('deactivated_at', null) == null;
    }
    function isLeagueManager(leagueId) {
      return hasLeagueRole(leagueId, ['PRESIDENT', 'COLLABORATOR']);
    }
    function isLeaguePresident(leagueId) {
      return hasLeagueRole(leagueId, ['PRESIDENT']);
    }
    function canReadLeague(leagueId) {
      return isLeagueMember(leagueId) || isSuperAdmin();
    }

    // Current week is always open; later days only up to settings/calendar.open_until (set by a manager)
    function nextMondayStart() {
      let now = toItalianTime(request.time);
      return now.date() + duration.value(8 - now.dayOfWeek(), 'd');
    }
    function isDateOpenForPlayers(leagueId, d) {
      let cal = /databases/$(database)/documents/leagues/$(leagueId)/settings/calendar;
      return dateToTimestamp(d) < nextMondayStart()
        || (exists(cal) && d <= get(cal).data.get('open_until', ''));
    }
    // C12: withdrawal lock, same as the app: from N hours before 20:30 (Italian time) of the match day
    function matchStartUtc(d) {
      let localStart = dateToTimestamp(d) + duration.value(20, 'h') + duration.value(30, 'm');
      return isItalianSummerTime(localStart) ? localStart - duration.value(2, 'h') : localStart - duration.value(1, 'h');
    }
    function isWithdrawLocked(leagueId, d) {
      let cfg = /databases/$(database)/documents/leagues/$(leagueId)/settings/app_config;
      return exists(cfg)
        && get(cfg).data.get('timelock_enabled', false) == true
        && request.time >= matchStartUtc(d) - duration.value(int(get(cfg).data.get('timelock_hours_before', 4)), 'h');
    }

    function isValidNewPresence(presenceId) {
      let data = request.resource.data;
      return data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.player_id is string
        && presenceId == data.date + '_' + data.player_id   // one presence per player per day
        && data.joined_at == request.time                   // queue position = server time, cannot be faked
        && data.keys().hasOnly(['id', 'date', 'player_id', 'status', 'order_index', 'created_at', 'joined_at']);
    }

    // MVP votes: everyone in the league votes (doc id = date_uid), from the match day up to 3 days later;
    // earlier only for managers or during a "test with everyone" on that day; never on behalf of someone else.
    function isMvpTestForAll(leagueId, d) {
      let teams = /databases/$(database)/documents/leagues/$(leagueId)/generated_teams/$(d);
      return exists(teams) && get(teams).data.get('mvp_vote_test', false) == 'all';
    }
    function isValidMvpVote(leagueId, voteId) {
      let data = request.resource.data;
      return data.keys().hasOnly(['date', 'voter_id', 'player_id', 'updated_at'])
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.voter_id == request.auth.uid
        && voteId == data.date + '_' + request.auth.uid
        && data.player_id is string
        && data.player_id.size() > 0
        && data.updated_at == request.time
        && (isLeagueManager(leagueId)
            || isMvpTestForAll(leagueId, data.date)
            || (request.time >= dateToTimestamp(data.date)
                && request.time < dateToTimestamp(data.date) + duration.value(3, 'd')));
    }

    // Role changes on a card: presidents only; never the platform super admin's card, guests never become managers.
    function leagueRoleChange(leagueId, playerId) {
      return isLeaguePresident(leagueId)
        && playerId != 'p-1'
        && request.resource.data.get('leagueRole', 'PLAYER') in ['PRESIDENT', 'COLLABORATOR', 'PLAYER']
        && request.resource.data.get('role', 'player') in ['admin', 'player']
        && (request.resource.data.get('leagueRole', 'PLAYER') == 'PLAYER' || resource.data.get('is_guest', false) == false);
    }

    match /memberships/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    match /leagues/{leagueId} {
      allow read: if canReadLeague(leagueId);
      allow write: if false; // created by the server (step 2: create league)

      // ---------- player cards ----------
      match /players/{playerId} {
        allow read: if canReadLeague(leagueId);
        // Managers add guests (players without an account)
        allow create: if isLeagueManager(leagueId)
          && request.resource.data.get('userId', null) == null
          && request.resource.data.get('is_guest', false) == true
          && request.resource.data.get('leagueRole', 'PLAYER') == 'PLAYER';
        // Managers: parameters, records, data (the account link never; roles only presidents).
        // The player: only name, photo and position of their own card.
        allow update: if (isLeagueManager(leagueId)
              && !('userId' in changedKeys())
              && (!changedKeys().hasAny(['leagueRole', 'role']) || leagueRoleChange(leagueId, playerId)))
          || (canWriteLeague(leagueId)
              && resource.data.get('userId', null) == request.auth.uid
              && onlyChanges(['full_name', 'avatar_url', 'position', 'updated_at'])
              && (!('avatar_url' in changedKeys()) || isValidAvatar(request.resource.data.avatar_url)));
        allow delete: if isLeagueManager(leagueId)
          && playerId != 'p-1'
          && resource.data.get('userId', null) == null
          && resource.data.get('is_guest', false) == true;
      }

      // ---------- presences ----------
      // Titolari / waitlist are COMPUTED by the app from the sign-up order (joined_at = server time).
      match /presences/{presenceId} {
        allow read: if canReadLeague(leagueId);
        // Players sign up only themselves (their card), only on open days. Managers add anyone on any day.
        allow create: if canWriteLeague(leagueId)
          && isValidNewPresence(presenceId)
          && (isLeagueManager(leagueId)
              || (request.resource.data.player_id == myPlayerId(leagueId)
                  && isDateOpenForPlayers(leagueId, request.resource.data.date)));
        // Withdraw: own presence (not during the withdrawal lock, C12), or anyone's for managers
        allow delete: if isLeagueManager(leagueId)
          || (canWriteLeague(leagueId)
              && resource.data.player_id == myPlayerId(leagueId)
              && !isWithdrawLocked(leagueId, resource.data.date));
        allow update: if isLeagueManager(leagueId);
      }

      // ---------- club data: members read, managers write ----------
      match /stat_categories/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /settings/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /matches/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /generated_teams/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /match_payments/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /sport_fields/{id} {
        allow read: if canReadLeague(leagueId);
        allow write: if isLeagueManager(leagueId);
      }
      match /mvp_votes/{voteId} {
        allow read: if canReadLeague(leagueId);
        allow create, update: if canWriteLeague(leagueId) && isValidMvpVote(leagueId, voteId);
        allow delete: if isLeagueManager(leagueId) || (canWriteLeague(leagueId) && resource.data.voter_id == request.auth.uid);
      }
      // Managers' notification centre: written only by the server. notify_state / invites: server only (denied).
      match /admin_requests/{id} {
        allow read: if isLeagueManager(leagueId);
        allow write: if false;
      }
    }

    // ---------- single-group collections (before multi-league): read-only backup ----------
    // The app now uses leagues/{leagueId}/…; nobody writes here any more (the migration copied them).
    // Only the super admin reads them (they hold data of every old member).
    match /stat_categories/{id} { allow read: if isSuperAdmin(); }
    match /settings/{id} { allow read: if isSuperAdmin(); }
    match /matches/{id} { allow read: if isSuperAdmin(); }
    match /generated_teams/{id} { allow read: if isSuperAdmin(); }
    match /presences/{id} { allow read: if isSuperAdmin(); }
    match /mvp_votes/{id} { allow read: if isSuperAdmin(); }
    match /match_payments/{id} { allow read: if isSuperAdmin(); }
    match /sport_fields/{id} { allow read: if isSuperAdmin(); }
    match /admin_requests/{id} { allow read: if isSuperAdmin(); }

    // Anything else is denied by default.
  }
}
